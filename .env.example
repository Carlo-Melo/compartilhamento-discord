# Somente desenvolvimento local. Copie para .env na raiz e substitua os valores.
# Os valores abaixo sao ficticios; .env permanece ignorado pelo Git.
# Use NAME=value sem espacos, aspas, # ou $ nos valores (senha hexadecimal e adequada).
POSTGRES_DB=compartilhamento_discord
# Se 5432 estiver ocupada, altere POSTGRES_PORT e a porta em DATABASE_URL juntos.
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/compartilhamento_discord
DATABASE_USERNAME=compartilhamento_dev
DATABASE_PASSWORD=substitua_por_uma_senha_local_aleatoria
